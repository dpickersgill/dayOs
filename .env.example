# Copy to .env for local use (never commit .env). On Cloud Run set these as env vars / Secret Manager secrets.

NODE_ENV=development
PORT=8080

# Aiven MySQL (find these on the service's connection page)
DB_HOST=your-service.aivencloud.com
DB_PORT=12345
DB_USER=avnadmin
DB_PASSWORD=change-me
DB_NAME=summitops
DB_SSL=true
# Paste the Aiven CA certificate text here (or leave empty to use the system trust store)
DB_CA=
DB_POOL=10

# At least 32 random characters. Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_TTL=12h

# Only you (the platform operator) know this. It is required to create a new mountain via POST /api/v1/tenants.
# Leave empty to disable tenant creation entirely.
BOOTSTRAP_KEY=

# Comma-separated list of browser origins allowed to call the API (admin app, public site). Empty = no browser CORS.
CORS_ORIGINS=

# Optional. Sign-in attempts per minute per address (default 10).
# LOGIN_RATE_LIMIT=10

# Self-serve demo (all optional)
# SANDBOX_DAYS=7
# SANDBOX_MAX_ACTIVE=40
# SANDBOX_RATE_LIMIT=5
# MARKETING_URL=https://your-website.example/contact
